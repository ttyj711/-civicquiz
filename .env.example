# ===== apps/server (Nitro) =====
# 监听端口（CloudRun 注入 PORT 时以平台为准）
PORT=3000

# PostgreSQL 连接串（本地开发示例；CloudRun 部署时改为 VPC 私有地址）
DATABASE_URL=postgres://user:pass@127.0.0.1:5432/civicquiz

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# 微信小程序
WX_APPID=
WX_APP_SECRET=

# 管理员初始账号（seed 用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ===== apps/admin (Vite) =====
VITE_API_BASE=http://localhost:3000

# ===== apps/miniapp (Taro) =====
# Taro 环境变量走 config/*.ts 注入，此文件仅作备忘
